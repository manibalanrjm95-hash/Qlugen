# Copy to .env.local for local/staging CMS work. Never enable in a production build yet.

# Base URL of the CMS Worker (wrangler dev serves http://127.0.0.1:8787). Used by /admin and the runtime.
VITE_CMS_API_BASE=http://127.0.0.1:8787

# true  = public pages render the CURRENT PUBLISHED CMS version from the Worker (falls back to local JSON on failure).
# unset = public pages use local JSON exactly as before.
VITE_CMS_RUNTIME_ENABLED=false

# How long the public site waits for published content before falling back to local JSON.
VITE_CMS_RUNTIME_TIMEOUT_MS=3000
