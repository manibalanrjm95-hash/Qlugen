# Frontend admin auth: real Firebase Email/Password only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=qlugen-enterprise.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qlugen-enterprise
VITE_FIREBASE_APP_ID=

# Admin API Cloud Function.
VITE_CMS_API_BASE=https://asia-south1-qlugen-enterprise.cloudfunctions.net/cmsAdminApi

# Public website CMS runtime/storage settings. Leave unset/false to use local JSON.
VITE_CMS_RUNTIME_ENABLED=false
VITE_CMS_RUNTIME_TIMEOUT_MS=3000
VITE_CMS_CONTENT_SOURCE=
VITE_CMS_STORAGE_BASE=
